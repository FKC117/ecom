SECRET_KEY=replace-with-a-generated-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=ecom
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password
DB_HOST=localhost
DB_PORT=5432
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave empty until the real Nginx/proxy peers are known. Never trust all public IPs.
COMMERCE_TRUSTED_PROXIES=
COMMERCE_TRACKING_RETENTION_DAYS=30
