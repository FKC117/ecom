SECRET_KEY=replace-with-a-generated-secret
DEBUG=True
# Optional absolute path; defaults to the repository's logs directory.
# LOG_DIR=D:/ecom/logs
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=ecom
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password
DB_HOST=localhost
DB_PORT=5432
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave empty until the real Nginx/proxy peers are known. Never trust all public IPs.
COMMERCE_TRUSTED_PROXIES=
COMMERCE_TRACKING_RETENTION_DAYS=30
# Courier credentials are environment-specific. Live access also requires an explicit opt-in.
PATHAO_LIVE_ENABLED=false
PATHAO_SANDBOX_CLIENT_ID=
PATHAO_SANDBOX_CLIENT_SECRET=
PATHAO_SANDBOX_USERNAME=
PATHAO_SANDBOX_PASSWORD=
PATHAO_LIVE_CLIENT_ID=
PATHAO_LIVE_CLIENT_SECRET=
PATHAO_LIVE_USERNAME=
PATHAO_LIVE_PASSWORD=
PATHAO_SANDBOX_WEBHOOK_URL_TOKEN=
PATHAO_SANDBOX_WEBHOOK_SIGNATURE_SECRET=
PATHAO_SANDBOX_WEBHOOK_INTEGRATION_SECRET=
PATHAO_LIVE_WEBHOOK_URL_TOKEN=
PATHAO_LIVE_WEBHOOK_SIGNATURE_SECRET=
# Match the Secret in Pathao's panel. Public live callback: /shipping/api/webhook/pathao/
# URL_TOKEN is needed only for the older token-in-URL callback; INTEGRATION_SECRET is optional.
PATHAO_LIVE_WEBHOOK_INTEGRATION_SECRET=
# Gemini assistants (server-only). Public chat is enabled in Site Settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
